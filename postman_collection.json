    {
      "name": "Registrar Usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();\nif (jsonData.id) {\n    pm.collectionVariables.set(\"user_id\", jsonData.id);\n    console.log(\"user_id guardado:\", jsonData.id);\n} else if (jsonData.data && jsonData.data.id) {\n    pm.collectionVariables.set(\"user_id\", jsonData.data.id);\n    console.log(\"user_id guardado:\", jsonData.data.id);\n}\npm.test(\"Registro exitoso\", function () {\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Geovany\",\n  \"email\": \"geovany.test2026@example.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "description": "Registra un nuevo usuario en el sistema. Guarda automáticamente el ID del usuario creado en la variable `user_id` de la colección para su uso en las siguientes peticiones."
      },
      "response": []
    },
    {
      "name": "Iniciar Sesión",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login exitoso\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set(\"auth_token\", jsonData.token);",
              "    console.log(\"Token guardado correctamente\");",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"geovany@example.com\", \"password\": \"password123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": [
            "{{base_url}}"
